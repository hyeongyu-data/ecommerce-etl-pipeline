# 실제 값은 .env 에 넣고 절대 커밋하지 마세요 (.gitignore 처리됨).
# 이 파일은 필요한 키 목록만 공유하는 용도입니다. 값은 비워 둡니다.

APP_ENV=local

# --- Docker Compose (로컬 Airflow) ---
# 아래는 모두 선택. 미설정 시 docker-compose.yaml 의 기본값이 쓰입니다.
# Linux 사용자는 파일 소유권 문제를 피하려면 AIRFLOW_UID=<id -u 결과> 를 설정하세요.
AIRFLOW_UID=
AIRFLOW_VERSION=

# --- GCP / BigQuery (통합 적재 대상) ---
# 서비스 계정 키 JSON 경로. 로컬 개발용이며 키 파일 자체는 커밋 금지.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
BQ_DATASET=

# --- GA4 Data API (이벤트 소스) ---
GA4_PROPERTY_ID=

# --- 오픈마켓 목업 API (주문 소스) ---
OPENMARKET_API_BASE_URL=
